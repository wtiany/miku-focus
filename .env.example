# Copy to .env; npm start loads it. .env is ignored by Git.
HOST=127.0.0.1
PORT=8642

# Public deployment: use HOST=0.0.0.0 and the exact public HTTPS origin.
# PUBLIC_ORIGIN=https://focus.example.com

# Optional STUN service. An empty value disables external STUN requests.
STUN_URL=stun:stun.l.google.com:19302

# Configure TURN for reliable remote connections (not included with this server).
# Comma-separated URLs from your TURN provider; never put secrets into room.js.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349

# coturn REST authentication: server generates credentials valid for 24 hours.
# TURN_SHARED_SECRET=replace-with-your-coturn-static-auth-secret

# Or provider-issued credentials (sent only to connected browser clients).
# TURN_USERNAME=replace-with-username
# TURN_CREDENTIAL=replace-with-password
