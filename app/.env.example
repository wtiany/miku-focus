# Local mode. For account-free public HTTPS sharing use npm run share instead.
HOST=127.0.0.1
PORT=8642

# Optional fixed-domain hosting (single Node instance with WebSocket support).
# HOST=0.0.0.0
# PUBLIC_ORIGIN=https://focus.example.com

# Music uses same-origin HTTP streaming; no STUN/TURN configuration is needed.
# Optional: use an already installed official cloudflared executable.
# CLOUDFLARED_PATH=C:\tools\cloudflared.exe
